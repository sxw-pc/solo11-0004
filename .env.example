# fillbot environment template. Copy to .env (not loaded automatically) or export.
# NEVER put real credentials in this repository.
# The values below are placeholders and are only meaningful for the local mock site.

# Target base URL. Keep the built-in local mock unless you have written authorization.
FILLBOT_BASE_URL=http://127.0.0.1:5000

# Runtime limits (optional; CLI flags win).
FILLBOT_TIMEOUT_SECONDS=10
FILLBOT_MAX_RETRIES=2
FILLBOT_BACKOFF_BASE_SECONDS=0.4
FILLBOT_RATE_LIMIT_PER_MINUTE=60
FILLBOT_FOLLOW_REDIRECTS=true
FILLBOT_EVIDENCE_KEEP_RUNS=10

# Per-site rate policies as compact JSON: {"host[:port]": {"field": value}}.
# Allowed fields: rate_limit_per_minute, timeout_seconds, max_retries,
# backoff_base_seconds, backoff_max_seconds, jitter. Invalid entries are ignored
# and that site keeps the global policy.
FILLBOT_SITE_POLICIES={"127.0.0.1:5000": {"rate_limit_per_minute": 120}}
FILLBOT_SITE_POLICY_RECOVERY_STREAK=3

# Where runtime artefacts live.
FILLBOT_LEDGER_PATH=data/ledger.db
FILLBOT_EVIDENCE_DIR=evidence
FILLBOT_RUNS_DIR=runs

# Mock site only. Accounts are seeded in fillbot/mocksite/seed.py.
# Passwords are placeholders of the form mock-only-... and are not real secrets.
FILLBOT_MOCK_USERNAME=parkco-b
FILLBOT_MOCK_PASSWORD=mock-only-beta

# Mock fault injection (disabled by default). Deterministic when a seed is given.
FILLBOT_CHAOS=0
FILLBOT_CHAOS_SEED=7
FILLBOT_CHAOS_RATE=0.0
FILLBOT_CHAOS_DELAY_MS=0
FILLBOT_CHAOS_RETRY_AFTER=1
FILLBOT_CHAOS_FLAKY_SUBMIT=0
FILLBOT_CHAOS_FLAKY_COMPANY=C003

# Never commit actual passwords/tokens. Real deployments should inject secrets.
